# SlitherEscape Studio — Apache rules for cPanel hosting.

Options -Indexes
DirectoryIndex index.php

# Never serve internals: config, includes, data (sessions, local DB) and dev tools.
RedirectMatch 404 ^.*/(inc|data|tools)(/.*)?$
<Files "config.php">
    Require all denied
</Files>

# Fonts and scripts can be cached; PHP pages carry ?v= cache-busting on assets.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>
